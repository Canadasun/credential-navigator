  "documents": [
    {
      "id": "wes-icap",
      "name": "WES Course-by-Course ICAP report",
      "description": "World Education Services Course-by-Course International Credential Advantage Package, issued in English. WES is the only international credential service APEGA recognizes, and no other WES product is accepted. It must include all transcripts, including transfer credits.",
