      "source": "apega-academic-docs"
    },
    {
      "id": "transcripts",
      "name": "Degree transcripts",
      "description": "Conferred undergraduate transcripts, plus postgraduate and transfer-credit transcripts if applicable, all evaluated within the WES report. APEGA does not accept transcripts sent by applicants.",
      "submitted_by": "third_party",
      "source": "apega-academic-docs"
    },
    {
      "id": "ap-transcripts",
      "name": "Advanced Placement transcripts",
      "description": "If applicable, sent directly to APEGA by the issuing school, because WES does not evaluate AP courses.",
