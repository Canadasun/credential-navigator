  "pathways": [
    {
      "id": "professional-member",
      "name": "Professional Member (P.Eng.)",
      "summary": "48 months of acceptable engineering experience. Requires Canadian citizenship or permanent residence.",
      "source": "apega-professional-member"
    },
    {
      "id": "licensee",
      "name": "Licensee",
      "summary": "Same academic and experience requirements as a professional member, without the citizenship or permanent residence requirement.",
      "source": "apega-professional-member"
    },
    {
      "id": "member-in-training",
      "name": "Member-in-Training",
      "summary": "For applicants with fewer than 48 months of acceptable engineering experience.",
      "source": "apega-professional-member"
    }
  ],
  "requirements": [
    {
      "id": "academic",
      "category": "education",
      "title": "Engineering degree",
      "description": "A degree from a program accredited by the Canadian Engineering Accreditation Board (CEAB), or one the Board of Examiners considers equivalent. Academic requirements must be complete before applying.",
      "pathways": [
        "professional-member",
        "licensee",
        "member-in-training"
      ],
      "source": "apega-professional-member"
    },
    {
      "id": "assigned-exams",
      "category": "exam",
      "title": "Exams assigned by the Board of Examiners",
      "description": "If the program is not accredited or equivalent, the Board of Examiners may assign the Fundamentals of Engineering exam and/or technical exams. An approved university course can be taken instead of a technical exam.",
      "pathways": [
        "professional-member",
        "licensee",
        "member-in-training"
      ],
      "source": "apega-technical",
      "conditional": true
    },
    {
      "id": "experience",
      "category": "experience",
      "title": "48 months of engineering experience",
      "description": "48 months of engineering work experience acceptable to the Board of Examiners. Applicants with less must apply as a member-in-training.",
      "pathways": [
        "professional-member",
        "licensee"
      ],
      "source": "apega-professional-member",
      "details": {
        "months": 48
      }
    },
    {
      "id": "competencies",
      "category": "experience",
      "title": "22 key competencies",
      "description": "Experience is scored 0 to 5 on 22 key competencies in six categories. Each category average must meet its minimum, and the eight Canadian work-environment competencies (1.1, 1.6, 1.9, 2.1, 2.2, 2.3, 5.1, 6.2) have their own minimums; a score below any minimum blocks submission. Required for applications from July 18, 2026.",
      "pathways": [
        "professional-member",
        "licensee"
      ],
      "source": "apega-scoring"
    },
    {
      "id": "references",
      "category": "experience",
      "title": "References and validators",
      "description": "Valid references and validators for the experience claimed.",
      "pathways": [
        "professional-member",
        "licensee"
      ],
      "source": "apega-professional-member"
    },
    {
      "id": "nppe",
      "category": "exam",
      "title": "National Professional Practice Exam (NPPE)",
      "description": "Must be passed before licensure. It can be written once a P.Eng. application is in progress; members-in-training write it only after applying for professional membership or licensure. Offered five times a year, written remotely, with a maximum of four attempts; four failures withdraw the application.",
      "pathways": [
        "professional-member",
        "licensee"
      ],
      "source": "apega-nppe-exam",
      "details": {
        "max_attempts": 4,
        "sittings_per_year": 5
      }
    },
    {
      "id": "english",
      "category": "language",
      "title": "English competency",
      "description": "Competency in written and spoken English.",
      "pathways": [
        "professional-member",
        "licensee",
        "member-in-training"
      ],
      "source": "apega-professional-member"
    },
    {
      "id": "good-character",
      "category": "character",
      "title": "Good character and reputation",
      "description": "Good character and reputation.",
      "pathways": [
        "professional-member",
        "licensee",
        "member-in-training"
      ],
      "source": "apega-professional-member"
    },
    {
      "id": "identity",
